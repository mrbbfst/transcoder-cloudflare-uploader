{
  "name": "transcoder-uploader",
  "version": "1.4.0",
  "description": "Desktop app for video HLS transcoding and Cloudflare R2 uploader",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "keywords": [
    "hls",
    "m3u8",
    "ffmpeg",
    "cloudflare",
    "r2",
    "transcoder",
    "electron"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/lib-storage": "^3.600.0",
    "fluent-ffmpeg": "^2.1.3",
    "mime-types": "^2.1.35"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.transcoder.uploader",
    "productName": "HLS Transcoder R2",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "package.json",
      "build/icon.png",
      "build/icon.icns"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.video",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Video"
    }
  }
}
